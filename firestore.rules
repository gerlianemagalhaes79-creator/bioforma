rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    match /test/{docId} {
      allow read: if true;
    }

    match /users/{uid} {
      allow read, write: if isAuthenticated();

      match /{allPaths=**} {
        allow read, write: if isAuthenticated();
      }
    }

    match /cronogramaProgress/{uid} {
      allow read, write: if isAuthenticated();
    }

    match /studyProgress/{id} {
      allow read, write: if isAuthenticated();
    }

    match /essays/{id} {
      allow read, write: if isAuthenticated();
    }

    match /tutorChats/{id} {
      allow read, write: if isAuthenticated();
    }

    match /simulados/{id} {
      allow read, write: if isAuthenticated();
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
