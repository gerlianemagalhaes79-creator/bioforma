rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read, write: if isAuthenticated();
    }

    match /studyProgress/{id} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid) && (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /essays/{id} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid) && (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /tutorChats/{id} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid) && (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    match /simulados/{id} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid) && (request.resource == null || request.resource.data.uid == request.auth.uid);
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
